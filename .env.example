APP_NAME=GradMatch
APP_ENV=development
APP_VERSION=0.1.0

DATABASE_URL=postgresql://gradmatch:change-me@localhost:5432/gradmatch
POSTGRES_DB=gradmatch
POSTGRES_USER=gradmatch
POSTGRES_PASSWORD=change-me

REDIS_URL=redis://localhost:6379/0

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=gradmatch-local
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me
OBJECT_STORAGE_REGION=local

EMAIL_FROM=noreply@example.test
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_USE_TLS=false

DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_SETTINGS_MODULE=gradmatch.settings

WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=GradMatch
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
