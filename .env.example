GRADMATCH_APP_NAME=GradMatch
GRADMATCH_ENVIRONMENT=development
GRADMATCH_APP_VERSION=0.1.0

DATABASE_URL=postgresql://gradmatch:change-me@localhost:5432/gradmatch
POSTGRES_DB=gradmatch
POSTGRES_USER=gradmatch
POSTGRES_PASSWORD=change-me

REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=gradmatch-local
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

EMAIL_FROM=noreply@example.test
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_USE_TLS=false

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_SECURE_COOKIES=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,caddy
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000
DJANGO_SETTINGS_MODULE=gradmatch.config.settings

WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=GradMatch
GRADMATCH_API_BASE_URL=http://localhost:8000

CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
