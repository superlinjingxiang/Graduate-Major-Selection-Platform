{
  "name": "gradmatch",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm exec turbo dev --parallel",
    "build": "pnpm exec turbo build",
    "lint": "pnpm exec biome check . --formatter-enabled=false --assist-enabled=false",
    "typecheck": "pnpm exec turbo typecheck",
    "test": "pnpm exec turbo test && pnpm test:tooling",
    "test:tooling": "node --test scripts/python-runtime.test.mjs scripts/native-status.test.mjs scripts/native-run.test.mjs",
    "status:native": "node scripts/native-status.mjs",
    "native:migrate": "node scripts/native-run.mjs migrate",
    "native:api": "node scripts/native-run.mjs api",
    "native:worker": "node scripts/native-run.mjs worker",
    "native:beat": "node scripts/native-run.mjs beat",
    "format:check": "pnpm exec biome check . --linter-enabled=false --assist-enabled=false",
    "generate:api": "node ./scripts/generate-api.mjs",
    "check:python": "node ./scripts/check-python.mjs",
    "check:api-drift": "node ./scripts/check-api-drift.mjs",
    "check:compose": "node ./scripts/check-compose.mjs",
    "check:ci": "node ./scripts/check-ci.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm check:python && pnpm build && pnpm check:api-drift && pnpm check:compose && pnpm check:ci",
    "e2e": "pnpm --filter @gradmatch/web exec playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "openapi-typescript": "7.13.0",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "yaml": "2.8.2",
    "@playwright/test": "1.54.2"
  }
}
