            "type": "string"
          }
        },
        "required": [
          "name",
          "environment",
          "version"
        ],
        "title": "MetaResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "enum": [
